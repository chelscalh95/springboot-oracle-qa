{
  "info": {
    "name": "springboot-oracle API (manual exploration and smoke checks)",
    "description": "Manual exploration of the four endpoints the application exposes, with basic assertions. Full automated coverage lives in the Playwright suite (qa/tests). Set baseUrl in the environment. Run folder items in order: 02-05 depend on each other. Records created here carry the prefix QA-PM- and are deleted in step 05.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 List individuals",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('body is a JSON array', () => pm.expect(pm.response.json()).to.be.an('array'));",
              "pm.test('every item has id, firstName, lastName, birthDate', () => {",
              "  pm.response.json().forEach(p => pm.expect(p).to.have.all.keys('id', 'firstName', 'lastName', 'birthDate'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals"
        }
      }
    },
    {
      "name": "02 Create individual",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('marker', 'QA-PM-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Quincy\",\n  \"lastName\": \"Tester-{{marker}}\",\n  \"birthDate\": \"1990-01-15\"\n}"
        },
        "description": "Generates a unique marker so the record can be found again (the API does not return the new id; see candidate defect DEF-003)."
      }
    },
    {
      "name": "03 Find the created individual (POST does not return the id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const created = pm.response.json().find(p => p.lastName.includes(pm.collectionVariables.get('marker')));",
              "pm.test('the record created in step 02 is in the list', () => pm.expect(created, 'not found').to.not.equal(undefined));",
              "if (created) pm.collectionVariables.set('personId', created.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals"
        }
      }
    },
    {
      "name": "04 Get individual by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('fields match what was created', () => {",
              "  const p = pm.response.json();",
              "  pm.expect(p.firstName).to.eql('Quincy');",
              "  pm.expect(p.birthDate).to.eql('1990-01-15');",
              "  pm.expect(p.id).to.eql(Number(pm.collectionVariables.get('personId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals/{{personId}}"
        }
      }
    },
    {
      "name": "05 Delete individual",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals/{{personId}}"
        }
      }
    },
    {
      "name": "06 Get the deleted individual (expects 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404 (expected behaviour, assumption TA-01)', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data-app/individuals/{{personId}}"
        },
        "description": "Candidate defect DEF-001: static analysis predicts HTTP 500 here, so this check is expected to fail until the application is fixed."
      }
    },
    {
      "name": "Validation (each expects 400)",
      "item": [
        {
          "name": "Create without firstName",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data-app/individuals"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lastName\": \"Tester-validation\",\n  \"birthDate\": \"1990-01-15\"\n}"
            }
          }
        },
        {
          "name": "Create with a future birthDate",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(); d.setUTCDate(d.getUTCDate() + 2);",
                  "pm.collectionVariables.set('futureDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data-app/individuals"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Quincy\",\n  \"lastName\": \"Tester-validation\",\n  \"birthDate\": \"{{futureDate}}\"\n}"
            }
          }
        },
        {
          "name": "Create with malformed JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data-app/individuals"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\": \"Quincy\", \"lastName\": "
            }
          }
        },
        {
          "name": "Get with a non-numeric id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/data-app/individuals/abc"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "marker",
      "value": ""
    },
    {
      "key": "personId",
      "value": ""
    },
    {
      "key": "futureDate",
      "value": ""
    }
  ]
}