# Copy this file to ".env" (git-ignored) and fill in the blanks.
# Variables already set in your shell take precedence over this file.
# Never commit real credentials.

# Base URL of the running Spring Boot application (no context path)
API_BASE_URL=http://localhost:8080

# Oracle schema that the application writes to (the same one the tests query)
ORACLE_USER=SPRINGORCL
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1

# Only used by docker-compose.yml: password of the database's SYS/SYSTEM accounts in the local container
ORACLE_SYS_PASSWORD=
